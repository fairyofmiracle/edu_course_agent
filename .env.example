# Заполните одну пару. Если заданы оба ключа, используется только CLOUDRU_API_KEY,
# Разрешены только два адреса. Любой другой, включая https://api.openai.com/v1,
# отклоняется до HTTP-запроса.
CLOUDRU_API_KEY=
CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1
CLOUDRU_MODEL=GigaChat/GigaChat-3-Pro
CLOUDRU_MODEL_WRITER=GigaChat/GigaChat-3-Pro

# Альтернативный шлюз GigaSchool.
# Если задан CLOUDRU_API_KEY, приоритет остаётся у Cloud.ru.
# Для существующей VM потребуется отдельно обновить имена переменных.
GIGASCHOOL_API_KEY=
GIGASCHOOL_BASE_URL=https://hub.gigaschool.ru/api/v1/llm/v1

# Next.js направляет оркестрацию в FastAPI. Браузер ходит на сайт, сайт — на API.
# Пустой STUDIO_API_TOKEN пускает только localhost. С токеном API закрыт и с этой машины.
PYTHON_AGENT_URL=http://127.0.0.1:8000
NEXT_PUBLIC_PYTHON_API_URL=http://127.0.0.1:8000

# Обязателен при запуске через Docker Compose.
# Укажите собственный случайный секретный токен.
STUDIO_API_TOKEN=

# Локально используется SQLite. В окружении замените на postgresql+psycopg://...
DATABASE_URL=sqlite:///backend/data/studio.db

# Docker Compose использует эти значения для PostgreSQL.
POSTGRES_DB=studio
POSTGRES_USER=studio
POSTGRES_PASSWORD=studio


