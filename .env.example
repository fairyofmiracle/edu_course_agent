# Ключ Foundation Models из личного кабинета Cloud.ru Evolution.
CLOUDRU_API_KEY=
CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1
CLOUDRU_MODEL=GigaChat/GigaChat-3-Pro
CLOUDRU_MODEL_WRITER=GigaChat/GigaChat-3-Pro

# На хакатонной VM эти переменные уже заданы и указывают на шлюз GigaSchool.
# OPENAI_* — имена совместимости, не адрес openai.com. Разрешены только два URL:
#   https://hub.gigaschool.ru/api/v1/llm/v1
#   https://foundation-models.api.cloud.ru/v1
# Локально скопируйте ключ из кабинета команды, не вставляйте его в чат.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://hub.gigaschool.ru/api/v1/llm/v1

# Next.js направляет оркестрацию в FastAPI; браузер сохраняет версии курса туда же.
PYTHON_AGENT_URL=http://127.0.0.1:8000
NEXT_PUBLIC_PYTHON_API_URL=http://127.0.0.1:8000

# Локально используется SQLite. В окружении замените на postgresql+psycopg://...
DATABASE_URL=sqlite:///backend/data/studio.db

# Docker Compose использует эти значения для PostgreSQL.
POSTGRES_DB=studio
POSTGRES_USER=studio
POSTGRES_PASSWORD=studio
