{
  "name": "edu-course-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "backend": "python -m uvicorn backend.app.main:app --reload --port 8000",
    "worker": "celery -A backend.app.gateway_queue.celery_app worker --loglevel=INFO --pool=solo",
    "backend:migrate": "python -m alembic upgrade head",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke:llm": "python scripts/smoke-llm.py",
    "smoke:e2e": "python scripts/smoke-e2e.py"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.84",
    "@ai-sdk/react": "^4.0.131",
    "@aiden0z/pptx-renderer": "^1.4.0",
    "ai": "^7.0.128",
    "docx": "^9.11.0",
    "mermaid": "^12.1.0",
    "next": "16.4.3",
    "pptxgenjs": "4.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "unpdf": "^1.8.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "image-size": "2.0.4",
    "undici": "7.30.1",
    "dompurify": "3.4.17"
  }
}
